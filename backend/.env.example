# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=your_openai_api_key_here

# Which LLM backend to use: "openai" (default) or "fake" (offline, deterministic replies).
LLM_PROVIDER=openai
# Model name passed to the provider.
LLM_MODEL=gpt-4o-mini

# SQLite database file for project files (default: backend/data/ide.db).
# DB_PATH=data/ide.db
